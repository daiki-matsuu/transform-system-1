<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>クイズ大会 ベットフォーム</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@500;700;900&family=Zen+Kaku+Gothic+New:wght@700;900&family=Oswald:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --sky1:#bfe9f2; --sky2:#3aa8dd; --sky3:#1f6fb8;
    --gold:#ffd23f;
    --gold-bright:#ffe27a;
    --gold-deep:#f5a623;
    --crimson:#e2394b;
    --bg-deep:#0e2a4a;
    --bg-panel:rgba(14,42,74,0.72);
    --ink:#ffffff;
    --ink-dim:#b9c8de;
    --a:#2f8fdd;
    --b:#e2394b;
    --c:#38b06a;
    --d:#f0b429;
    --ok:#38b06a;
    --ng:#e2394b;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0;padding:0;height:100%;}
  .num{font-family:'Oswald',sans-serif;}
  body{
    background:
      radial-gradient(1200px 700px at 50% -10%, var(--sky2) 0%, var(--sky3) 42%, var(--bg-deep) 82%);
    color:var(--ink);
    font-family:'Noto Sans JP', sans-serif;
    min-height:100vh;
    min-height:100dvh;
    display:flex; flex-direction:column;
    overscroll-behavior:none;
    -webkit-touch-callout:none;
  }
  button, .choice, .quick-btns button, .submit-btn{ touch-action:manipulation; }
  header{
    padding:14px 18px 12px;
    display:flex; justify-content:space-between; align-items:center;
    border-bottom:1px solid rgba(255,210,63,0.25);
    position:relative; z-index:60;
    background:var(--bg-deep);
  }
  .team-name{font-weight:900; font-size:15px; letter-spacing:.02em; color:var(--ink-dim);}
  .points-wrap{display:flex; align-items:center; gap:10px;}
  .points-box{text-align:right;}
  .points-label{font-size:10px; color:var(--ink-dim); letter-spacing:.1em;}
  .points-val{font-family:'Zen Kaku Gothic New',sans-serif; font-weight:900; font-size:28px; color:var(--gold-bright); line-height:1;}
  .points-val span{font-size:14px; margin-left:2px; color:var(--gold);}
  .debt-chip{
    display:none; align-items:center; gap:4px; background:rgba(255,95,109,0.15); border:1px solid var(--ng);
    color:#ff8f98; font-size:10.5px; font-weight:900; padding:5px 9px; border-radius:20px; white-space:nowrap;
  }
  .debt-chip.show{display:flex;}

  main{flex:1; padding:16px 18px 100px; overflow-y:auto;}

  .status-bar{
    display:flex; align-items:center; justify-content:space-between;
    background:var(--bg-panel); border:1px solid rgba(255,210,63,0.2);
    border-radius:14px; padding:10px 14px; margin-bottom:16px;
  }
  .phase-chip{
    font-size:11px; font-weight:900; padding:4px 10px; border-radius:20px;
    letter-spacing:.05em;
  }
  .phase-BETTING_OPEN{background:rgba(58,209,156,0.15); color:var(--ok); border:1px solid var(--ok);}
  .phase-BETTING_CLOSED{background:rgba(255,182,72,0.15); color:var(--d); border:1px solid var(--d);}
  .phase-REVEALED{background:rgba(255,95,109,0.15); color:var(--ng); border:1px solid var(--ng);}
  .phase-IDLE{background:rgba(154,160,184,0.15); color:var(--ink-dim); border:1px solid var(--ink-dim);}
  .phase-INTRO{background:rgba(122,143,255,0.15); color:#8fa4ff; border:1px solid #8fa4ff;}
  .timer{font-family:'Zen Kaku Gothic New',sans-serif; font-weight:900; font-size:22px; color:var(--ink); font-variant-numeric:tabular-nums;}
  .timer.urgent{color:var(--ng); animation:pulse 0.6s infinite alternate;}
  @keyframes pulse{from{opacity:1} to{opacity:.4}}

  .qno{font-size:12px; color:var(--gold); letter-spacing:.15em; font-weight:700; margin-bottom:6px;}
  .qtext{font-size:18px; font-weight:900; line-height:1.5; margin-bottom:18px;}

  .choices{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:20px;}
  .choice{
    position:relative; border-radius:16px; padding:16px 12px; cursor:pointer;
    border:2px solid rgba(255,255,255,0.08); background:var(--bg-panel);
    transition:transform .12s ease, border-color .12s ease, background .12s ease;
    min-height:78px; display:flex; flex-direction:column; justify-content:center;
  }
  .choice:active{transform:scale(0.97);}
  .choice .tag{font-weight:900; font-size:13px; margin-bottom:4px;}
  .choice .txt{font-size:13.5px; line-height:1.35; color:var(--ink);}
  .choice[data-c="A"] .tag{color:var(--a);}
  .choice[data-c="B"] .tag{color:var(--b);}
  .choice[data-c="C"] .tag{color:var(--c);}
  .choice[data-c="D"] .tag{color:var(--d);}
  .choice.selected{border-color:var(--gold); background:linear-gradient(180deg, rgba(255,210,63,0.14), rgba(255,210,63,0.04));}
  .choice.selected::after{
    content:"✓"; position:absolute; top:8px; right:10px; color:var(--gold-bright); font-weight:900;
  }

  .bet-panel{background:var(--bg-panel); border:1px solid rgba(255,210,63,0.2); border-radius:16px; padding:16px;}
  .bet-panel .row{display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px;}
  .bet-panel .lbl{font-size:12px; color:var(--ink-dim); font-weight:700; letter-spacing:.05em;}
  .bet-amount{font-family:'Zen Kaku Gothic New',sans-serif; font-weight:900; font-size:30px; color:var(--gold-bright);}
  input[type=range]{
    width:100%; height:8px; border-radius:6px; appearance:none; -webkit-appearance:none;
    background:linear-gradient(90deg, var(--gold) 0%, var(--gold) var(--pct,0%), rgba(255,255,255,0.12) var(--pct,0%));
    margin:10px 0 6px;
  }
  input[type=range]::-webkit-slider-thumb{
    -webkit-appearance:none; width:26px; height:26px; border-radius:50%;
    background:var(--gold-bright); border:3px solid var(--bg-deep); box-shadow:0 0 0 2px var(--gold);
  }
  .quick-btns{display:flex; gap:8px; margin-top:8px;}
  .quick-btns button{
    flex:1; padding:9px 0; border-radius:10px; border:1px solid rgba(255,255,255,0.15);
    background:rgba(255,255,255,0.04); color:var(--ink); font-weight:700; font-size:12.5px;
  }
  .quick-btns button:active{background:rgba(255,210,63,0.15); border-color:var(--gold);}

  footer{
    position:fixed; bottom:0; left:0; right:0; padding:14px 18px calc(14px + env(safe-area-inset-bottom));
    background:linear-gradient(0deg, var(--bg-deep) 60%, transparent);
  }
  .submit-btn{
    width:100%; padding:16px; border:none; border-radius:16px; font-size:17px; font-weight:900;
    background:linear-gradient(180deg, var(--gold-bright), var(--gold));
    color:#241a04; letter-spacing:.05em; box-shadow:0 6px 20px rgba(255,210,63,0.35);
  }
  .submit-btn:disabled{background:#3a3f55; color:#7a7f95; box-shadow:none;}
  .submit-btn:active:not(:disabled){transform:scale(0.98);}

  .msg{text-align:center; font-size:12.5px; margin-top:10px; min-height:16px; color:var(--ink-dim);}
  .msg.ok{color:var(--ok);}
  .msg.ng{color:var(--ng);}

  .overlay{
    position:fixed; top:70px; left:0; right:0; bottom:0; background:rgba(10,12,22,0.92); display:none;
    align-items:center; justify-content:center; flex-direction:column; text-align:center; padding:30px;
    z-index:50;
  }
  .overlay.show{display:flex;}
  .overlay .big{font-size:26px; font-weight:900; color:var(--gold-bright); margin-bottom:10px;}
  .overlay .sub{font-size:14px; color:var(--ink-dim); line-height:1.6;}

  /* ===== チーム成績画面 ===== */
  .results-screen{
    position:fixed; inset:0; z-index:150; background:var(--bg-deep); display:none;
    flex-direction:column; overflow-y:auto; -webkit-overflow-scrolling:touch; padding:20px 16px 40px;
    scrollbar-width:none;
  }
  .results-screen::-webkit-scrollbar{display:none;}
  .results-screen.show{display:flex;}
  .results-hero{text-align:center; padding:10px 0 18px;}
  .results-hero .rt{font-size:13px; color:var(--ink-dim); font-weight:700; letter-spacing:.15em;}
  .results-hero .team{font-size:20px; font-weight:900; color:var(--gold-bright); margin-top:2px;}
  .results-stats{display:flex; gap:10px; margin:14px 0 6px;}
  .results-stats .card{
    flex:1; background:var(--bg-panel); border:1px solid rgba(255,210,63,0.3); border-radius:16px;
    padding:16px 8px; text-align:center;
  }
  .results-stats .card .lbl{font-size:11px; color:var(--ink-dim); font-weight:700; margin-bottom:6px;}
  .results-stats .card .val{font-size:26px; font-weight:900; color:var(--gold-bright); font-family:'Zen Kaku Gothic New',sans-serif;}
  .results-stats .card .val small{font-size:13px; color:var(--ink-dim);}
  .results-section{margin-top:22px;}
  .results-section h3{font-size:14px; font-weight:900; margin:0 0 10px; color:var(--ink);}
  .results-section .desc{font-size:11px; color:var(--ink-dim); margin:-4px 0 10px;}
  .chart-box{background:var(--bg-panel); border-radius:16px; padding:14px 10px 6px; border:1px solid rgba(255,255,255,0.08);}
  .scatter-tip{
    margin-top:10px; min-height:64px; background:var(--bg-panel); border:1px solid rgba(255,210,63,0.3);
    border-radius:12px; padding:12px 16px; font-size:13px; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:4px; color:var(--ink-dim); text-align:center;
  }
  .scatter-tip .tip-name{font-size:15px; font-weight:900; color:var(--ink);}
  .scatter-tip .tip-name.me{color:var(--crimson);}
  .scatter-tip .tip-row{display:flex; gap:16px; flex-wrap:wrap; justify-content:center;}
  .scatter-tip .tip-row b{color:var(--gold-bright); font-size:14px;}
  .scatter-tip .tip-row span.k{color:var(--ink-dim); font-size:11px; margin-right:3px;}
  .results-close{
    margin:26px auto 4px; padding:11px 34px; border-radius:12px; border:1px solid rgba(255,255,255,0.2);
    background:transparent; color:var(--ink-dim); font-weight:700; font-size:13px;
  }
  .results-fab{
    position:fixed; top:12px; right:12px; z-index:60; display:none;
    flex-direction:column; align-items:center; justify-content:center;
    width:52px; height:52px; border-radius:16px; border:none;
    background:linear-gradient(180deg, var(--gold-bright), var(--gold));
    color:#241a04; font-weight:900; font-size:10px; line-height:1.3;
    box-shadow:0 4px 14px rgba(0,0,0,0.35); padding:0;
  }
  .results-fab.show{display:flex;}
  .results-fab .ic{font-size:18px; margin-bottom:1px;}

  .id-gate{
    position:fixed; inset:0; background:var(--bg-deep); z-index:100;
    display:flex; align-items:center; justify-content:center; flex-direction:column; padding:24px;
  }
  .id-gate .title{font-weight:900; font-size:20px; color:var(--gold-bright); margin-bottom:4px;}
  .id-gate .sub2{font-size:12px; color:var(--ink-dim); margin-bottom:14px;}
  .id-gate .search{
    width:100%; max-width:340px; padding:13px 16px; border-radius:12px; border:2px solid rgba(255,210,63,0.5);
    background:var(--bg-panel); color:var(--ink); font-size:15px; margin-bottom:12px; font-weight:700;
  }
  .team-list{
    width:100%; max-width:340px; max-height:46vh; overflow-y:auto; border-radius:14px;
    border:1px solid rgba(255,210,63,0.25); background:var(--bg-panel);
  }
  .team-list .item{
    display:flex; align-items:center; gap:10px; padding:13px 16px; cursor:pointer;
    border-bottom:1px solid rgba(255,255,255,0.06); font-weight:700; font-size:15px;
  }
  .team-list .item:last-child{border-bottom:none;}
  .team-list .item .no{color:var(--gold); font-weight:900; min-width:28px; font-family:'Zen Kaku Gothic New',sans-serif;}
  .team-list .item.selected{background:linear-gradient(180deg, rgba(255,210,63,0.18), rgba(255,210,63,0.05));}
  .team-list .item:active{background:rgba(255,210,63,0.12);}
  .team-list .empty{padding:20px; text-align:center; color:var(--ink-dim); font-size:13px;}
  .id-gate button.enter-btn{
    margin-top:16px; padding:13px 40px; border-radius:12px; border:none; background:var(--gold);
    color:#241a04; font-weight:900; font-size:15px; touch-action:manipulation;
  }
  .id-gate button.enter-btn:disabled{background:#3a3f55; color:#7a7f95;}
</style>
</head>
<body>

<div class="id-gate" id="idGate">
  <div class="title">🏆 チームを選択</div>
  <div class="sub2">毎回この画面から、参加するチームを選んでください</div>
  <input class="search" id="teamSearch" type="text" placeholder="チーム名・番号で検索" oninput="renderTeamList()">
  <div class="team-list" id="teamList"><div class="empty">読み込み中...</div></div>
  <button class="enter-btn" id="enterBtn" onclick="enterTeam()" disabled>入場する</button>
</div>

<header>
  <div class="team-name" id="teamName">-</div>
  <div class="points-wrap">
    <div class="debt-chip" id="debtChip">💰 借入 <span id="debtVal">0</span>pt</div>
    <div class="points-box">
      <div class="points-label">保有ポイント</div>
      <div class="points-val" id="pointsVal">-<span>pt</span></div>
    </div>
  </div>
</header>

<button class="results-fab" id="resultsFab" onclick="openTeamResultsManually()"><span class="ic">📊</span>成績</button>

<main>
  <div class="status-bar">
    <div class="phase-chip phase-IDLE" id="phaseChip">待機中</div>
    <div class="timer" id="timer">--</div>
  </div>

  <div id="questionArea">
    <div class="qno" id="qno">問題待機中</div>
    <div class="qtext" id="qtext">まもなく問題が出題されます。スクリーンをご覧ください。</div>

    <div class="choices" id="choices">
      <div class="choice" data-c="A" onclick="selectChoice('A')"><div class="tag">A</div><div class="txt" id="txtA">-</div></div>
      <div class="choice" data-c="B" onclick="selectChoice('B')"><div class="tag">B</div><div class="txt" id="txtB">-</div></div>
      <div class="choice" data-c="C" onclick="selectChoice('C')"><div class="tag">C</div><div class="txt" id="txtC">-</div></div>
      <div class="choice" data-c="D" onclick="selectChoice('D')"><div class="tag">D</div><div class="txt" id="txtD">-</div></div>
    </div>

    <div class="bet-panel">
      <div class="row">
        <div class="lbl">BET ポイント</div>
        <div class="bet-amount"><span id="betAmount">0</span>pt</div>
      </div>
      <input type="range" id="betSlider" min="0" max="100" step="1" value="0" oninput="onSlider()">
      <div class="quick-btns">
        <button onclick="setPct(0.25)">25%</button>
        <button onclick="setPct(0.5)">50%</button>
        <button onclick="setPct(0.75)">75%</button>
        <button onclick="setPct(1)">ALL IN</button>
      </div>
    </div>
  </div>
</main>

<footer>
  <button class="submit-btn" id="submitBtn" onclick="submitBet()" disabled>選択肢を選んでください</button>
  <div class="msg" id="msg"></div>
</footer>

<div class="overlay" id="lockedOverlay">
  <div class="big" id="lockedBig">⏱ ベット締切</div>
  <div class="sub" id="lockedSub">結果発表をお待ちください。スクリーンをご覧ください。</div>
</div>

<div class="results-screen" id="resultsScreen">
  <div class="results-hero">
    <div class="rt">🏆 チーム成績</div>
    <div class="team" id="rTeamName">-</div>
  </div>
  <div class="results-stats">
    <div class="card"><div class="lbl">最終ポイント</div><div class="val"><span id="rFinalPt">-</span><small>pt</small></div></div>
    <div class="card"><div class="lbl">最終順位</div><div class="val"><span id="rFinalRank">-</span><small id="rFinalRankSuffix">位</small></div></div>
  </div>

  <div class="results-section">
    <h3>📈 ポイントの推移</h3>
    <div class="chart-box"><svg id="chartPoints" viewBox="0 0 320 130" style="width:100%; display:block;"></svg></div>
  </div>

  <div class="results-section">
    <h3>🏅 順位の推移</h3>
    <div class="chart-box"><svg id="chartRank" viewBox="0 0 320 130" style="width:100%; display:block;"></svg></div>
  </div>

  <div class="results-section">
    <h3>🎯 相対評価（全チーム）</h3>
    <div class="desc">横軸：正解数 ／ 縦軸：合計ベットpt。赤い点が自チームです。他の点をタップすると詳細が見られます。</div>
    <div class="chart-box"><svg id="chartScatter" viewBox="0 0 320 220" style="width:100%; display:block;"></svg></div>
    <div class="scatter-tip" id="scatterTip">点をタップしてください</div>
  </div>

  <button class="results-close" onclick="document.getElementById('resultsScreen').classList.remove('show')">閉じる（ベット画面に戻る）</button>
</div>

<script>
/* =========================================================
 * ここを必ず書き換えてください：GASの「ウェブアプリURL」
 * ========================================================= */
const API_URL = 'https://script.google.com/macros/s/AKfycbxxkzo0yvarQlNSO-1W1uMQN1wOUCSlrJC-AwL169T3bq887sKgyqwkkrcbogiCxTlC/exec';

let teamId = '';
let currentChoice = null;
let currentPoints = 0;
let lastPhase = null;
let lastQNo = null;
let submitted = false;
let isSubmitting = false;
let pollTimer = null;
let countdownTimer = null;
let deadline = null;
let serverOffset = 0; // server_time - Date.now()
let teamRoster = [];
let selectedTeamId = null;
let hasSeenResults = false;

/* 投票フォームに入るたびに、必ずこのチーム選択画面から開始する
   （前回選んだチームを自動で引き継がない） */
async function loadTeamRoster(){
  const listEl = document.getElementById('teamList');
  try{
    const res = await fetch(API_URL + '?action=team_list&_=' + Date.now(), { cache:'no-store' });
    const data = await res.json();
    if(data.ok){
      teamRoster = data.teams;
      renderTeamList();
    } else {
      listEl.innerHTML = '<div class="empty">チーム一覧の取得に失敗しました</div>';
    }
  }catch(err){
    listEl.innerHTML = '<div class="empty">通信エラー。画面を再読み込みしてください</div>';
  }
}

function renderTeamList(){
  const q = (document.getElementById('teamSearch').value || '').trim().toLowerCase();
  const listEl = document.getElementById('teamList');
  const filtered = teamRoster.filter(t =>
    !q || String(t.team_id).includes(q) || String(t.team_name).toLowerCase().includes(q)
  );
  if(filtered.length === 0){
    listEl.innerHTML = '<div class="empty">該当するチームがありません</div>';
    return;
  }
  listEl.innerHTML = filtered.map(t =>
    '<div class="item' + (t.team_id === selectedTeamId ? ' selected' : '') + '" onclick="pickTeam(' + t.team_id + ')">' +
      '<span class="no">' + t.team_id + '</span><span>' + escapeHtmlForm(t.team_name) + '</span>' +
    '</div>'
  ).join('');
}

function escapeHtmlForm(s){ return String(s).replace(/[&<>"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m])); }

function pickTeam(id){
  selectedTeamId = id;
  document.getElementById('enterBtn').disabled = false;
  renderTeamList();
}

function enterTeam(){
  if(!selectedTeamId) return;
  teamId = selectedTeamId;
  document.getElementById('idGate').style.display = 'none';
  startPolling();
}

loadTeamRoster();

function fmtTime(ms){
  if(ms < 0) ms = 0;
  const s = Math.ceil(ms/1000);
  const m = Math.floor(s/60);
  const r = s % 60;
  return String(m).padStart(2,'0') + ':' + String(r).padStart(2,'0');
}

function selectChoice(c){
  if(submitted || isSubmitting) return;
  currentChoice = c;
  document.querySelectorAll('.choice').forEach(el=>{
    el.classList.toggle('selected', el.dataset.c === c);
  });
  updateSubmitState();
}

function onSlider(){
  const v = Number(document.getElementById('betSlider').value);
  document.getElementById('betAmount').textContent = v;
  const pct = currentPoints > 0 ? (v/currentPoints*100) : 0;
  document.getElementById('betSlider').style.setProperty('--pct', pct + '%');
  updateSubmitState();
}

function setPct(p){
  const v = Math.floor(currentPoints * p);
  document.getElementById('betSlider').value = v;
  onSlider();
}

function updateSubmitState(){
  const btn = document.getElementById('submitBtn');
  const amount = Number(document.getElementById('betSlider').value);
  // submitted / isSubmitting のどちらか一方でも真なら、問答無用でボタンを閉じる。
  // ここでボタンを開けるのは「未送信・未選択」の通常フロー時のみ。
  if(submitted || isSubmitting){
    btn.disabled = true;
    btn.textContent = isSubmitting ? '送信中...' : '送信済み ✓';
    return;
  }
  if(!currentChoice){ btn.disabled = true; btn.textContent = '選択肢を選んでください'; return; }
  btn.disabled = false;
  btn.textContent = currentChoice + ' に ' + amount + 'pt ベットする';
}

async function submitBet(){
  if(!currentChoice || submitted || isSubmitting) return;
  const amount = Number(document.getElementById('betSlider').value);
  // ここで即座にロック（サーバー応答を待たず、ポーリングとの競合や連打による
  // 二重送信の余地をゼロにする）。失敗した場合のみ後で解除する。
  isSubmitting = true;
  updateSubmitState();
  try{
    const res = await fetch(API_URL, {
      method:'POST',
      headers:{'Content-Type':'text/plain;charset=utf-8'},
      body: JSON.stringify({action:'bet', team_id:teamId, choice:currentChoice, amount:amount})
    });
    const data = await res.json();
    const msgEl = document.getElementById('msg');
    if(data.ok){
      submitted = true;
      isSubmitting = false;
      msgEl.textContent = data.message;
      msgEl.className = 'msg ok';
      updateSubmitState();
    } else {
      isSubmitting = false;
      msgEl.textContent = data.error;
      msgEl.className = 'msg ng';
      updateSubmitState();
    }
  }catch(err){
    isSubmitting = false;
    document.getElementById('msg').textContent = '通信エラー。もう一度お試しください。';
    document.getElementById('msg').className = 'msg ng';
    updateSubmitState();
  }
}

function setPhaseChip(phase){
  const chip = document.getElementById('phaseChip');
  chip.className = 'phase-chip phase-' + phase;
  const labels = {IDLE:'待機中', INTRO:'問題紹介中', BETTING_OPEN:'ベット受付中', BETTING_CLOSED:'締切・正解発表待ち', REVEALED:'結果発表'};
  chip.textContent = labels[phase] || phase;
}

/* ===================== ポーリング（v12で全面的に見直し） =====================
 * 旧実装は「自分より新しいリクエストが発行済みなら応答を捨てる」判定だったため、
 * サーバー応答がポーリング間隔（650ms）より遅いと全応答が捨てられ、画面が
 * 一切更新されなくなっていた。v12では応答を受けてから次を予約する方式にし、
 * 破棄するのは「既に描画済みの応答より古いもの」だけに限定している。
 * ========================================================================= */
const POLL_MIN_MS = 500;
const POLL_MAX_MS = 5000;
let pollSeq = 0;
let lastRenderedSeq = 0;
let pollFailCount = 0;
let lastReloadToken = null;

async function poll(){
  if(!teamId){ setTimeout(poll, POLL_MIN_MS); return; }
  const mySeq = ++pollSeq;
  let nextDelay = POLL_MIN_MS;
  try{
    const t0 = Date.now();
    const res = await fetch(API_URL + '?action=team_state&team_id=' + encodeURIComponent(teamId) + '&_=' + Date.now(), { cache:'no-store' });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    const t1 = Date.now();
    if(!data.ok){
      document.getElementById('msg').textContent = data.error;
      document.getElementById('msg').className = 'msg ng';
      throw new Error(data.error || 'サーバーがエラーを返しました');
    }
    pollFailCount = 0;
    nextDelay = Math.min(POLL_MAX_MS, Math.max(POLL_MIN_MS, t1 - t0));

    // 管理者パネルの「強制リロード」に反応する（初回はトークンを記憶するだけ）
    if(lastReloadToken === null){
      lastReloadToken = data.reload_token || '';
    } else if((data.reload_token || '') !== lastReloadToken){
      location.reload();
      return;
    }

    // 既に描画済みの応答より古いものだけ捨てる
    if(mySeq < lastRenderedSeq) return;
    lastRenderedSeq = mySeq;
    // 通信の往復時間の半分を見込んで補正することで、会場Wi-Fiの遅延があっても
    // スクリーン・投票フォーム・管理者パネル間の残り時間のズレを最小化する
    const estServerNow = data.server_time + (t1 - t0) / 2;
    serverOffset = estServerNow - t1;
    currentPoints = data.team.points;
    const debt = data.team.debt || 0;
    document.getElementById('teamName').textContent = data.team.team_name;
    document.getElementById('pointsVal').innerHTML = currentPoints + '<span>pt</span>';
    const debtChip = document.getElementById('debtChip');
    document.getElementById('debtVal').textContent = debt;
    debtChip.classList.toggle('show', debt > 0);
    setPhaseChip(data.phase);
    deadline = data.deadline;

    const qChanged = data.question && data.question.q_no !== lastQNo;
    const phaseChanged = data.phase !== lastPhase;

    // 問題文・ベット状況・ロック画面の描画は独立したtry/catchで保護する。
    // ここで例外が起きても、チーム名/pt/フェーズ表示（上で更新済み）は反映されたままにし、
    // かつ下のlastPhase/lastQNo更新も必ず行うことで、同じ原因で永久に描画が止まり続けるのを防ぐ。
    try{
      if(data.question){
        document.getElementById('qno').textContent = '第 ' + data.question.q_no + ' 問';
        document.getElementById('qtext').textContent = data.question.text;
        document.getElementById('txtA').textContent = data.question.choices.A;
        document.getElementById('txtB').textContent = data.question.choices.B;
        document.getElementById('txtC').textContent = data.question.choices.C;
        document.getElementById('txtD').textContent = data.question.choices.D;
      }

      if(data.phase === 'BETTING_OPEN'){
        document.getElementById('lockedOverlay').classList.remove('show');
        if(qChanged || (phaseChanged && !data.team.submitted)){
          // 新しい問題 → リセット
          currentChoice = null;
          submitted = false;
          document.getElementById('betSlider').max = currentPoints;
          document.getElementById('betSlider').value = 0;
          onSlider();
          document.querySelectorAll('.choice').forEach(el=>el.classList.remove('selected'));
          document.getElementById('msg').textContent = '';
        }
        if(data.team.submitted){
          submitted = true;
          currentChoice = data.team.bet_choice;
          document.querySelectorAll('.choice').forEach(el=>{
            el.classList.toggle('selected', el.dataset.c === currentChoice);
          });
          document.getElementById('betSlider').value = data.team.bet_amount;
          onSlider();
        }
        document.getElementById('betSlider').max = Math.max(currentPoints,0);
        updateSubmitState();
      } else if(data.phase === 'BETTING_CLOSED' || data.phase === 'REVEALED'){
        document.getElementById('lockedBig').textContent = data.phase === 'REVEALED' ? '🎉 結果発表中' : '⏱ ベット締切';
        document.getElementById('lockedSub').textContent = data.phase === 'REVEALED'
          ? 'スクリーンで結果をご確認ください。次の問題までお待ちください。'
          : '正解発表をお待ちください。スクリーンをご覧ください。';
        document.getElementById('lockedOverlay').classList.add('show');
      } else if(data.phase === 'INTRO'){
        document.getElementById('lockedBig').textContent = '🎬 問題紹介中';
        document.getElementById('lockedSub').textContent = 'まもなくベットが始まります。スクリーンをご覧ください。';
        document.getElementById('lockedOverlay').classList.add('show');
      } else {
        document.getElementById('lockedOverlay').classList.remove('show');
      }

      if(data.show_team_results && !hasSeenResults){
        hasSeenResults = true;
        document.getElementById('resultsFab').classList.add('show');
        document.getElementById('resultsScreen').classList.add('show');
        loadTeamResults();
      }
    }catch(err){ console.error('[poll] 問題/ベット状態の描画でエラー:', err); }

    lastPhase = data.phase;
    lastQNo = data.question ? data.question.q_no : null;
  }catch(err){
    pollFailCount++;
    console.error('[poll] 通信に失敗しました（' + pollFailCount + '回連続）:', err);
    nextDelay = Math.min(POLL_MAX_MS, POLL_MIN_MS * Math.pow(2, Math.min(pollFailCount, 4)));
  }finally{
    setTimeout(poll, nextDelay);
  }
}

function tickCountdown(){
  const timerEl = document.getElementById('timer');
  if(deadline && lastPhase === 'BETTING_OPEN'){
    const remain = deadline - (Date.now() + serverOffset);
    timerEl.textContent = fmtTime(remain);
    timerEl.classList.toggle('urgent', remain < 10000);
    if(remain <= 0){
      document.getElementById('lockedBig').textContent = '⏱ ベット締切';
      document.getElementById('lockedSub').textContent = '集計中です。少々お待ちください。';
      document.getElementById('lockedOverlay').classList.add('show');
    }
  } else {
    timerEl.textContent = '--:--';
    timerEl.classList.remove('urgent');
  }
}

function startPolling(){
  poll(); // pollは自分自身で次回を予約する（setIntervalは使わない）
  countdownTimer = setInterval(tickCountdown, 200);
}

/* ===================== チーム成績画面 ===================== */
function openTeamResultsManually(){
  document.getElementById('resultsScreen').classList.add('show');
  loadTeamResults(); // 開くたびに最新の状態を取り直す
}

async function loadTeamResults(){
  try{
    const res = await fetch(API_URL + '?action=team_results&team_id=' + encodeURIComponent(teamId) + '&_=' + Date.now(), { cache:'no-store' });
    const data = await res.json();
    if(!data.ok) return;
    renderTeamResults(data);
  }catch(err){ /* 次にresultsScreenが再表示されたタイミングで再取得される */ }
}

function renderTeamResults(data){
  document.getElementById('rTeamName').textContent = document.getElementById('teamName').textContent;
  document.getElementById('rFinalPt').textContent = data.final_points;
  document.getElementById('rFinalRank').textContent = data.final_rank;
  document.getElementById('rFinalRankSuffix').textContent = '/' + data.total_teams + '位';

  drawLineChart('chartPoints', data.journey.map(j=>({x:j.q_no, y:j.points_after})), {color:'#e8c15c', invert:false, suffix:'pt'});
  drawLineChart('chartRank', data.journey.map(j=>({x:j.q_no, y:j.rank_after})), {color:'#3aa0ff', invert:true, suffix:'位'});
  drawScatter('chartScatter', data.all_teams);
}

function svgEl(tag, attrs){
  const el = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for(const k in attrs) el.setAttribute(k, attrs[k]);
  return el;
}

function drawLineChart(svgId, points, opts){
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  if(!points.length){
    svg.appendChild(svgEl('text', {x:160, y:65, 'text-anchor':'middle', fill:'#7a7f95', 'font-size':'12'}));
    svg.lastChild.textContent = 'まだデータがありません';
    return;
  }
  const W = 320, H = 130, padL = 26, padR = 12, padT = 16, padB = 22;
  const xs = points.map(p=>p.x), ys = points.map(p=>p.y);
  const xMin = Math.min(...xs), xMax = Math.max(...xs);
  let yMin = Math.min(...ys), yMax = Math.max(...ys);
  if(yMin === yMax){ yMin -= 1; yMax += 1; }
  const yPad = (yMax - yMin) * 0.2;
  yMin -= yPad; yMax += yPad;

  const xScale = x => xMax === xMin ? (padL + (W-padL-padR)/2) : padL + (x - xMin) / (xMax - xMin) * (W - padL - padR);
  const yScale = y => {
    const t = (y - yMin) / (yMax - yMin);
    return opts.invert ? padT + t * (H - padT - padB) : (H - padB) - t * (H - padT - padB);
  };

  const g = svgEl('g', {});

  // 横グリッド線
  for(let i=0;i<=2;i++){
    const ly = padT + (H-padT-padB) * i/2;
    g.appendChild(svgEl('line', {x1:padL, x2:W-padR, y1:ly, y2:ly, stroke:'rgba(255,255,255,0.08)'}));
  }

  // 折れ線
  const d = points.map((p,i)=> (i===0?'M':'L') + xScale(p.x).toFixed(1) + ',' + yScale(p.y).toFixed(1)).join(' ');
  g.appendChild(svgEl('path', {d:d, fill:'none', stroke:opts.color, 'stroke-width':'2.5', 'stroke-linejoin':'round', 'stroke-linecap':'round'}));

  const showAllLabels = points.length <= 6;
  points.forEach((p,i)=>{
    const cx = xScale(p.x), cy = yScale(p.y);
    const isEdge = (i===0 || i===points.length-1);
    g.appendChild(svgEl('circle', {cx:cx, cy:cy, r:'3.5', fill:opts.color}));

    if(showAllLabels || isEdge){
      const t = svgEl('text', {x:cx, y:cy - 8, 'text-anchor':'middle', 'font-size':'9', fill:opts.color, 'font-weight':'700'});
      t.textContent = p.y + (opts.suffix||'');
      g.appendChild(t);
    }
    if(showAllLabels || i % 2 === 0 || isEdge){
      const xt = svgEl('text', {x:cx, y:H - 6, 'text-anchor':'middle', 'font-size':'9', fill:'#7a7f95'});
      xt.textContent = '第' + p.x + '問';
      g.appendChild(xt);
    }
  });

  svg.appendChild(g);
}

function drawScatter(svgId, teams){
  const svg = document.getElementById(svgId);
  svg.innerHTML = '';
  document.getElementById('scatterTip').textContent = '点をタップしてください';
  if(!teams || !teams.length) return;

  const W = 320, H = 220, padL = 34, padR = 16, padT = 26, padB = 34;
  const xs = teams.map(t=>t.correct_count), ys = teams.map(t=>t.total_bet);
  const xMax = Math.max(...xs, 1) + 1;
  const yMax = Math.max(...ys, 1) * 1.15 || 10;

  const xScale = x => padL + (x / xMax) * (W - padL - padR);
  const yScale = y => (H - padB) - (y / yMax) * (H - padT - padB);

  const g = svgEl('g', {});
  g.appendChild(svgEl('line', {x1:padL, x2:W-padR, y1:H-padB, y2:H-padB, stroke:'rgba(255,255,255,0.25)'}));
  g.appendChild(svgEl('line', {x1:padL, x2:padL, y1:padT, y2:H-padB, stroke:'rgba(255,255,255,0.25)'}));

  const xl = svgEl('text', {x:(padL+W-padR)/2, y:H-6, 'text-anchor':'middle', 'font-size':'10', fill:'#9aa0b8'});
  xl.textContent = '正解数 →';
  g.appendChild(xl);
  const yl = svgEl('text', {x:6, y:padT-8, 'font-size':'10', fill:'#9aa0b8'});
  yl.textContent = '↑ 合計ベットpt';
  g.appendChild(yl);

  const others = teams.filter(t=>!t.is_me);
  const me = teams.find(t=>t.is_me);

  others.forEach(t=>{
    const c = svgEl('circle', {
      cx:xScale(t.correct_count), cy:yScale(t.total_bet), r:'7',
      fill:'#3aa0ff', 'fill-opacity':'0.55', stroke:'#0a0c16', 'stroke-width':'1'
    });
    c.style.cursor = 'pointer';
    c.addEventListener('click', ()=> showScatterTip(t));
    g.appendChild(c);
  });

  if(me){
    const c = svgEl('circle', {
      cx:xScale(me.correct_count), cy:yScale(me.total_bet), r:'10',
      fill:'#c8283f', stroke:'#fff', 'stroke-width':'2'
    });
    c.style.cursor = 'pointer';
    c.addEventListener('click', ()=> showScatterTip(me));
    g.appendChild(c);

    showScatterTip(me);
  }

  svg.appendChild(g);
}

function showScatterTip(t){
  const el = document.getElementById('scatterTip');
  el.innerHTML =
    '<div class="tip-name' + (t.is_me ? ' me' : '') + '">' + escapeHtmlForm(t.team_name) + '</div>' +
    '<div class="tip-row">' +
      '<span><span class="k">最終pt</span><b>' + t.final_points + '</b></span>' +
      '<span><span class="k">最終順位</span><b>' + t.final_rank + '位</b></span>' +
    '</div>' +
    '<div class="tip-row">' +
      '<span><span class="k">正解数</span><b>' + t.correct_count + '</b></span>' +
      '<span><span class="k">合計bet</span><b>' + t.total_bet + 'pt</b></span>' +
    '</div>';
}

